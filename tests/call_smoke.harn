import { call } from "../src/lib"

pipeline test_call_smoke(task) {
  egress_policy({allow: ["api.slack.com"], default: "deny"})
  http_mock_clear()
  // F8: api_base_url is allowlisted to {slack.com, api.slack.com}; tests must
  // use one of those hosts even when targeting the http_mock layer.
  let base = "https://api.slack.com"
  let token = "xoxb-test-token"
  http_mock(
    "POST",
    base + "/*",
    {status: 200, body: "{\"ok\":true,\"channel\":\"C111\",\"ts\":\"1713650000.000100\"}", headers: {}},
  )
  let posted = call("chat.postMessage", {api_base_url: base, bot_token: token, channel: "C111", text: "hello"})
  assert_eq(posted.ok, true, "postMessage ok")
  assert_eq(posted.channel, "C111", "postMessage response channel")
  call(
    "chat.getPermalink",
    {
      api_base_url: base,
      bot_token: token,
      bot_token_secret: "slack/bot-token",
      signing_secret: "webhook-secret-must-not-leak",
      signing_secret_id: "custom-signing-secret-id",
      config: {webhook_secret: "nested-webhook-secret-must-not-leak"},
      channel: "C111",
      message_ts: "1713650000.000100",
    },
  )
  call(
    "chat.update",
    {api_base_url: base, bot_token: token, channel: "C111", ts: "1.1", text: "updated"},
  )
  call("chat.delete", {api_base_url: base, bot_token: token, channel: "C111", ts: "1.1"})
  call("conversations.history", {api_base_url: base, bot_token: token, channel: "C111", limit: 2})
  call("conversations.replies", {api_base_url: base, bot_token: token, channel: "C111", ts: "1.1"})
  call("users.info", {api_base_url: base, bot_token: token, user_id: "U111"})
  call("users.lookupByEmail", {api_base_url: base, bot_token: token, email: "person@example.test"})
  call(
    "reactions.add",
    {api_base_url: base, bot_token: token, channel: "C111", timestamp: "1.1", name: "eyes"},
  )
  call(
    "reactions.remove",
    {api_base_url: base, bot_token: token, channel: "C111", timestamp: "1.1", name: "eyes"},
  )
  call(
    "views.open",
    {api_base_url: base, bot_token: token, trigger_id: "trigger-1", view: {type: "modal"}},
  )
  call("views.update", {api_base_url: base, bot_token: token, view_id: "V111", view: {type: "modal"}})
  call(
    "apps.connections.open",
    {api_base_url: base, app_token: "xapp-test-token", app_token_secret: "slack/app-token"},
  )
  let calls = http_mock_calls()
  assert_eq(len(calls), 13, "all required outbound methods dispatched")
  let post_body = json_parse(calls[0].body)
  let permalink_body = json_parse(calls[1].body)
  let user_info_body = json_parse(calls[6].body)
  let lookup_body = json_parse(calls[7].body)
  let reaction_body = json_parse(calls[8].body)
  let modal_body = json_parse(calls[11].body)
  let socket_body = json_parse(calls[12].body)
  assert_eq(calls[0].method, "POST", "post uses POST")
  assert_eq(calls[0].url, base + "/chat.postMessage", "post URL")
  assert_eq(calls[0].headers.authorization, "[redacted]", "authorization header is redacted")
  assert_eq(post_body.text, "hello", "post body text")
  assert_eq(calls[1].url, base + "/chat.getPermalink", "permalink URL")
  assert_eq(permalink_body.message_ts, "1713650000.000100", "permalink message ts")
  assert(permalink_body.bot_token_secret == nil, "bot token secret id is not sent")
  assert(permalink_body.signing_secret == nil, "webhook signing secret is not sent")
  assert(permalink_body.signing_secret_id == nil, "webhook signing secret id is not sent")
  assert(permalink_body.config == nil, "connector config is not sent")
  assert_eq(calls[6].url, base + "/users.info", "users.info URL")
  assert_eq(user_info_body.user, "U111", "users.info user_id normalized")
  assert(user_info_body.user_id == nil, "users.info strips user_id alias")
  assert_eq(calls[7].url, base + "/users.lookupByEmail", "users.lookupByEmail URL")
  assert_eq(lookup_body.email, "person@example.test", "users.lookupByEmail body")
  assert_eq(calls[8].url, base + "/reactions.add", "reactions.add URL")
  assert_eq(reaction_body.name, "eyes", "reaction name")
  assert_eq(calls[11].url, base + "/views.update", "views.update URL")
  assert_eq(modal_body.view.type, "modal", "modal view body")
  assert_eq(calls[12].url, base + "/apps.connections.open", "apps.connections.open URL")
  assert(socket_body.app_token_secret == nil, "app token secret id is not sent")
  let disclosure = {
    byline: "AI-assisted by Merge Captain for Kenneth Sinder.",
    customize: {username: "Merge Captain", icon_emoji: ":robot_face:"},
    ai_mark: {
      enabled: true,
      event_type: "harn.ai_disclosure.v1",
      event_payload: {kind: "ai_generated", generator: "harn", surface: "slack"},
    },
  }
  http_mock_clear()
  http_mock(
    "POST",
    base + "/chat.postMessage",
    {status: 200, body: "{\"ok\":true,\"channel\":\"C111\",\"ts\":\"1713650000.000100\"}", headers: {}},
  )
  call(
    "chat.postMessage",
    {
      api_base_url: base,
      bot_token: token,
      channel: "C111",
      text: "ready",
      username: "Should Not Ship",
      icon_emoji: ":x:",
      _harn: {disclosure: {slack: disclosure}},
    },
  )
  let fallback_body = json_parse(http_mock_calls({include_sensitive: true})[0].body)
  assert(fallback_body.username == nil, "custom username is stripped without chat:write.customize")
  assert(fallback_body.icon_emoji == nil, "custom icon is stripped without chat:write.customize")
  assert(
    starts_with(fallback_body.text, "AI-assisted by Merge Captain for Kenneth Sinder.\n\n"),
    "fallback text byline is prepended",
  )
  assert_eq(
    fallback_body.metadata.event_payload.harn.ai_disclosure.kind,
    "ai_generated",
    "AI marker is attached as Slack metadata",
  )
  http_mock_clear()
  http_mock(
    "POST",
    base + "/chat.postMessage",
    {status: 200, body: "{\"ok\":true,\"channel\":\"C111\",\"ts\":\"1713650000.000101\"}", headers: {}},
  )
  call(
    "chat.postMessage",
    {
      api_base_url: base,
      bot_token: token,
      channel: "C111",
      text: "ready",
      granted_scopes: ["chat:write", "chat:write.customize"],
      _harn: {disclosure: {slack: disclosure}},
    },
  )
  let custom_body = json_parse(http_mock_calls({include_sensitive: true})[0].body)
  assert_eq(custom_body.text, "ready", "customized messages keep caller text")
  assert_eq(custom_body.username, "Merge Captain", "custom username is sent with granted scope")
  assert_eq(custom_body.icon_emoji, ":robot_face:", "custom icon is sent with granted scope")
  assert_eq(
    custom_body.metadata.event_payload.harn.ai_disclosure.surface,
    "slack",
    "customized messages keep AI metadata",
  )
  http_mock_clear()
  http_mock(
    "POST",
    base + "/chat.postMessage",
    {status: 200, body: "{\"ok\":true,\"channel\":\"C111\",\"ts\":\"1713650000.000102\"}", headers: {}},
  )
  let alias_posted = call("post_message", {api_base_url: base, bot_token: token, channel: "C111", text: "alias"})
  let alias_call = http_mock_calls({include_sensitive: true})[0]
  assert_eq(alias_posted.ok, true, "friendly post_message alias succeeds")
  assert_eq(alias_call.url, base + "/chat.postMessage", "friendly alias uses chat.postMessage")
  http_mock_clear()
  http_mock(
    "POST",
    base + "/chat.postMessage",
    {status: 200, body: "{\"ok\":false,\"error\":\"channel_not_found\"}", headers: {}},
  )
  let slack_error = call("chat.postMessage", {api_base_url: base, bot_token: token, channel: "missing", text: "hello"})
  assert(is_err(slack_error), "ok false becomes Err")
  assert_eq(unwrap_err(slack_error).message, "channel_not_found", "ok false error")
  http_mock_clear()
  http_mock(
    "POST",
    base + "/conversations.history",
    {
      status: 200,
      body: "{\"ok\":false,\"error\":\"missing_scope\",\"needed\":\"channels:history\",\"provided\":\"chat:write\"}",
      headers: {},
    },
  )
  let missing_scope = call("conversations.history", {api_base_url: base, bot_token: token, channel: "C111"})
  assert(is_err(missing_scope), "missing scope is explicit")
  assert_eq(unwrap_err(missing_scope).code, "missing_scope", "missing scope code")
  assert_eq(
    unwrap_err(missing_scope).details.needed,
    "channels:history",
    "missing scope needed detail",
  )
  http_mock_clear()
  let unsupported = call("pins.add", {api_base_url: base, bot_token: token})
  assert(is_err(unsupported), "unsupported method rejected")
  assert_eq(unwrap_err(unsupported).code, "method_not_found", "unsupported method code")
  let app_token_for_bot_method = call(
    "chat.postMessage",
    {api_base_url: base, app_token: "xapp-test-token", channel: "C111", text: "hello"},
  )
  assert(is_err(app_token_for_bot_method), "app token is not accepted for bot-token methods")
  assert_eq(
    unwrap_err(app_token_for_bot_method).code,
    "missing_bot_token",
    "bot token still required",
  )
  // F8: outbound calls to non-allowlisted hosts must be rejected so that bot
  // tokens never reach attacker-controlled origins.
  let disallowed = call(
    "chat.postMessage",
    {api_base_url: "https://evil.example/api", bot_token: token, channel: "C111", text: "x"},
  )
  assert(is_err(disallowed), "non-allowlisted api_base_url rejected")
  assert_eq(unwrap_err(disallowed).code, "disallowed_api_base_url", "disallowed host code")
}
