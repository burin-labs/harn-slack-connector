import {
  activate,
  init,
  kinds,
  outbound_methods,
  payload_schema,
  provider_id,
  shutdown,
} from "../src/lib"

let TEST_TS = 1713659999

let TEST_RECEIVED_AT = "2024-04-21T00:39:59Z"

/** Return a fixed timestamp inside Slack's signature replay window for deterministic fixtures. */
pub fn fixture_ts() {
  return TEST_TS
}

/** Return the fixed RFC3339 timestamp matching fixture_ts(). */
pub fn fixture_received_at() {
  return TEST_RECEIVED_AT
}

/** Build signed Slack request headers for fixture webhook bodies. */
pub fn slack_headers(secret, body, ts) {
  let basestring = "v0:" + to_string(ts) + ":" + body
  return {
    "x-slack-request-timestamp": to_string(ts),
    "x-slack-signature": "v0=" + hmac_sha256(secret, basestring),
  }
}

/** Build a raw Events API request wrapper around a signed fixture body. */
pub fn signed_raw(secret, body, ts, extra = nil) {
  let raw = {signing_secret: secret, body_text: body, headers: slack_headers(secret, body, ts), now: ts}
  return raw + extra ?? {}
}

/** Read a Slack webhook fixture body by basename. */
pub fn fixture_body(harness, name) {
  return harness.fs.read_text(source_dir() + "/fixtures/webhooks/" + name + ".json")
}

/** Build a signed raw Events API request for a named webhook fixture. */
pub fn fixture_raw(harness, name, secret, ts, extra = nil) {
  return signed_raw(secret, fixture_body(harness, name), ts, extra)
}

/** Assert the public connector metadata and lifecycle exports stay usable. */
pub fn assert_slack_interface() {
  shutdown()
  require provider_id() == "slack", "provider id"
  require kinds()[0] == "webhook", "webhook kind"
  require payload_schema().harn_schema_name == "SlackEventPayload", "payload schema name"
  require payload_schema().json_schema.type == "object", "payload schema json object"
  let methods = outbound_methods()
  require methods[0].method == "apps.connections.open", "method policies are exposed"
  require methods[2].method == "chat.postMessage", "write method is listed"
  require methods[2].requires_approval, "write method requires approval"
  let initialized = init({signing_secret: "test-secret", include_bot_messages: false})
  require initialized.initialized, "init stores state"
  let activated = activate([{id: "primary", path: "/slack/events", secrets: {signing_secret: "test-secret"}}])
  require activated.bindings == 1, "activate counts bindings"
}
