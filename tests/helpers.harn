import {
  activate,
  init,
  kinds,
  outbound_methods,
  payload_schema,
  provider_id,
  shutdown,
} from "../src/lib"

/**
 * Return an integer Unix-seconds timestamp inside Slack's 5-minute
 * signature replay window.
 *
 * After F10 the connector verifies request freshness against the trusted
 * clock (`harness.clock.timestamp()`), so fixtures must sign with a current
 * timestamp rather than a hard-coded value. Slack request timestamps are
 * always whole seconds, so we truncate the float here.
 */
pub fn fixture_ts(harness: HarnessClock) {
  return to_int(harness.timestamp())
}

/** Build signed Slack request headers for fixture webhook bodies. */
pub fn slack_headers(secret, body, ts) {
  const basestring = "v0:" + to_string(ts) + ":" + body
  return {
    "x-slack-request-timestamp": to_string(ts),
    "x-slack-signature": "v0=" + hmac_sha256(secret, basestring),
  }
}

/**
 * Build a raw Events API request wrapper around a signed fixture body.
 *
 * After F10 the connector ignores `raw.now`/`raw.received_at` and uses the
 * trusted clock, so this builder no longer plants those fields.
 */
pub fn signed_raw(secret, body, ts, extra = nil) {
  const raw = {signing_secret: secret, body_text: body, headers: slack_headers(secret, body, ts)}
  return raw + (extra ?? {})
}

/**
 * Build a signed raw `application/x-www-form-urlencoded` request (slash
 * commands and interactivity payloads). Slack signs the raw body the same way
 * as the Events API, so we reuse `slack_headers` and add the form content-type.
 */
pub fn signed_form_raw(secret, body, ts, extra = nil) {
  const raw = {
    signing_secret: secret,
    body_text: body,
    headers: slack_headers(secret, body, ts)
      + {"content-type": "application/x-www-form-urlencoded"},
  }
  return raw + (extra ?? {})
}

/** Read a Slack webhook fixture body by basename. */
pub fn fixture_body(harness: HarnessFs, name) {
  return harness.read_text(harness.source_dir() + "/fixtures/webhooks/" + name + ".json")
}

/** Build a signed raw Events API request for a named webhook fixture. */
pub fn fixture_raw(harness: HarnessFs, name, secret, ts, extra = nil) {
  return signed_raw(secret, fixture_body(harness, name), ts, extra)
}

fn method_policy_by_name(methods, name) {
  for method in methods {
    if method.method == name {
      return method
    }
  }
  return nil
}

/** Assert the public connector metadata and lifecycle exports stay usable. */
pub fn assert_slack_interface(harness: Harness) {
  shutdown(harness)
  require provider_id() == "slack", "provider id"
  require kinds()[0] == "webhook", "webhook kind"
  require payload_schema().harn_schema_name == "SlackEventPayload", "payload schema name"
  require payload_schema().json_schema.type == "object", "payload schema json object"
  const methods = outbound_methods()
  require methods[0].method == "apps.connections.open", "method policies are exposed"
  const post_message = method_policy_by_name(methods, "chat.postMessage")
  require post_message != nil, "write method is listed"
  require post_message.requires_approval, "write method requires approval"
  const file_info = method_policy_by_name(methods, "files.info")
  require file_info != nil, "files.info method is listed"
  require !file_info.requires_approval, "files.info does not require approval"
  const artifact_import = method_policy_by_name(methods, "artifact.import_request")
  require artifact_import != nil, "artifact import method is listed"
  require artifact_import.requires_approval, "artifact import requires approval"
  const initialized = init(harness, {signing_secret: "test-secret", include_bot_messages: false})
  require initialized.initialized, "init stores state"
  const activated = activate(
    harness,
    [{id: "primary", path: "/slack/events", secrets: {signing_secret: "test-secret"}}],
  )
  require activated.bindings == 1, "activate counts bindings"
}
