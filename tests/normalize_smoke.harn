import { normalize_inbound, shutdown } from "../src/lib"
import {
  assert_slack_interface,
  fixture_body,
  fixture_ts,
  signed_raw,
  slack_headers,
} from "./helpers"

pipeline test_normalize_smoke(harness) {
  const secret = "test-signing-secret"
  const ts = fixture_ts(harness)
  assert_slack_interface()
  const url_body = fixture_body(harness, "url_verification")
  const url_result = normalize_inbound(signed_raw(secret, url_body, ts))
  assert_eq(url_result.type, "immediate_response", "url verification result type")
  assert_eq(url_result.immediate_response.status, 200, "url verification status")
  assert_eq(url_result.immediate_response.body, "challenge-abc-123", "url verification challenge")
  assert_eq(
    url_result.immediate_response.headers["content-type"],
    "text/plain; charset=utf-8",
    "url verification content type",
  )
  assert(url_result.event == nil, "url verification skips event")
  const event_body = fixture_body(harness, "message_channel_1")
  const event_result = normalize_inbound(signed_raw(secret, event_body, ts))
  assert_eq(event_result.type, "event", "event callback result type")
  assert_eq(event_result.event.kind, "message", "message event type")
  assert_eq(event_result.event.dedupe_key, "slack:event:Ev-message-1", "message dedupe key")
  assert_eq(event_result.event.payload.resource_id, "C111/1713650000.000100", "message resource id")
  assert_eq(
    event_result.event.headers["X-Slack-Signature"],
    "[redacted]",
    "signature header redacted",
  )
  assert(event_result.event.headers["x-slack-signature"] == nil, "raw signature header is omitted")
  assert_eq(
    event_result.event.payload.provider_raw.headers["X-Slack-Signature"],
    "[redacted]",
    "provider raw signature redacted",
  )
  const empty_body = normalize_inbound(
    {signing_secret: secret, headers: slack_headers(secret, "", ts)},
  )
  assert_eq(empty_body.type, "reject", "empty body rejects (F12)")
  assert_eq(empty_body.reject.status, 400, "empty body status")
  assert_eq(empty_body.reject.body.error, "missing_body_text", "empty body error")
  const retry_result = normalize_inbound(
    signed_raw(
      secret,
      event_body,
      ts,
      {
        headers: slack_headers(secret, event_body, ts)
          + {
          "x-slack-retry-num": "1",
          "x-slack-retry-reason": "http_timeout",
        },
      },
    ),
  )
  assert_eq(retry_result.type, "event", "retry result type")
  assert_eq(retry_result.event.payload.retry.is_retry, true, "retry flag")
  assert_eq(retry_result.event.payload.retry.num, 1, "retry num")
  assert_eq(retry_result.event.payload.retry.reason, "http_timeout", "retry reason")
  assert_eq(retry_result.event.payload.metrics.slack_retry_delivery, 1, "retry metric")
  assert_eq(retry_result.event.headers["X-Slack-Retry-Num"], "1", "canonical retry num header")
  assert_eq(
    retry_result.event.dedupe_key,
    event_result.event.dedupe_key,
    "retry keeps deterministic dedupe",
  )
  const unsupported_body =
    "{\"token\":\"legacy-token\",\"team_id\":\"T123\",\"api_app_id\":\"A123\",\"event\":{\"type\":\"workflow_step_execute\",\"user\":\"U111\",\"channel\":\"D111\",\"event_ts\":\"1713650400.000100\"},\"type\":\"event_callback\",\"event_id\":\"Ev-unsupported\",\"event_time\":1713650400}"
  const unsupported = normalize_inbound(signed_raw(secret, unsupported_body, ts))
  assert_eq(unsupported.type, "reject", "unsupported event rejects")
  assert_eq(unsupported.reject.status, 400, "unsupported event status")
  assert_eq(unsupported.reject.body.error, "unsupported_event", "unsupported event error")
  const tampered = normalize_inbound(
    {
      signing_secret: secret,
      body_text: event_body + " ",
      headers: slack_headers(secret, event_body, ts),
    },
  )
  assert_eq(tampered.type, "reject", "tampered body rejects")
  assert_eq(tampered.reject.status, 403, "tampered body status")
  assert_eq(tampered.reject.body.error, "invalid_signature", "tampered body error")
  const missing_signature = normalize_inbound(
    {
      signing_secret: secret,
      body_text: event_body,
      headers: {"x-slack-request-timestamp": to_string(ts)},
    },
  )
  assert_eq(missing_signature.type, "reject", "missing signature rejects")
  assert_eq(missing_signature.reject.body.error, "missing_signature", "missing signature error")
  // F10: the connector now derives `now` from the trusted clock — callers can no
  // longer plant a stale request-timestamp by overriding `raw.now`.
  const expired_ts = ts - 301
  const expired = normalize_inbound(
    {
      signing_secret: secret,
      body_text: event_body,
      headers: slack_headers(secret, event_body, expired_ts),
    },
  )
  assert_eq(expired.type, "reject", "expired timestamp rejects")
  assert_eq(expired.reject.body.error, "expired_timestamp", "expired timestamp error")
  const wrong_secret = normalize_inbound(
    {
      signing_secret: "wrong-secret",
      body_text: event_body,
      headers: slack_headers(secret, event_body, ts),
    },
  )
  assert_eq(wrong_secret.type, "reject", "wrong secret rejects")
  assert_eq(wrong_secret.reject.body.error, "invalid_signature", "wrong secret error")
  shutdown()
}
