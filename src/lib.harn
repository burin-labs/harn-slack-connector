let SLACK_PROVIDER_ID = "slack"

let SLACK_API_BASE_URL = "https://slack.com/api"

/**
 * Hosts permitted for outbound Slack Web API calls. Caller-supplied
 * `api_base_url` overrides are validated against this allowlist to prevent
 * bot/app tokens from being shipped to attacker-controlled hosts.
 */
let SLACK_ALLOWED_API_HOSTS = ["slack.com", "api.slack.com"]

let SLACK_SIGNATURE_WINDOW_SECONDS = 300

let SLACK_REDACTED_HEADER_VALUE = "[redacted]"

let SLACK_CUSTOMIZE_SCOPE = "chat:write.customize"

let SLACK_OUTBOUND_METHOD_POLICIES = [
  {
    method: "apps.connections.open",
    mutates_provider: false,
    requires_approval: false,
    token_kind: "app",
  },
  {method: "chat.getPermalink", mutates_provider: false, requires_approval: false, token_kind: "bot"},
  {method: "chat.postMessage", mutates_provider: true, requires_approval: true, token_kind: "bot"},
  {method: "chat.update", mutates_provider: true, requires_approval: true, token_kind: "bot"},
  {method: "chat.delete", mutates_provider: true, requires_approval: true, token_kind: "bot"},
  {
    method: "conversations.history",
    mutates_provider: false,
    requires_approval: false,
    token_kind: "bot",
  },
  {
    method: "conversations.replies",
    mutates_provider: false,
    requires_approval: false,
    token_kind: "bot",
  },
  {method: "users.info", mutates_provider: false, requires_approval: false, token_kind: "bot"},
  {
    method: "users.lookupByEmail",
    mutates_provider: false,
    requires_approval: false,
    token_kind: "bot",
  },
  {method: "reactions.add", mutates_provider: true, requires_approval: true, token_kind: "bot"},
  {method: "reactions.remove", mutates_provider: true, requires_approval: true, token_kind: "bot"},
  {method: "views.open", mutates_provider: true, requires_approval: true, token_kind: "bot"},
  {method: "views.update", mutates_provider: true, requires_approval: true, token_kind: "bot"},
  {method: "chat.postEphemeral", mutates_provider: true, requires_approval: true, token_kind: "bot"},
  {
    method: "assistant.threads.setStatus",
    mutates_provider: true,
    requires_approval: true,
    token_kind: "bot",
  },
  {
    method: "assistant.threads.setSuggestedPrompts",
    mutates_provider: true,
    requires_approval: true,
    token_kind: "bot",
  },
  {
    method: "assistant.threads.setTitle",
    mutates_provider: true,
    requires_approval: true,
    token_kind: "bot",
  },
]

var SLACK_STATE = {initialized: false, active: false, bindings: {}, ctx: {}}

/** Return this connector's Harn provider id. */
pub fn provider_id() {
  return SLACK_PROVIDER_ID
}

/** Return the trigger kinds supported by this connector. */
pub fn kinds() {
  return ["webhook"]
}

/** Return outbound Slack Web API method policies for host-side approval gates. */
pub fn outbound_methods() {
  return SLACK_OUTBOUND_METHOD_POLICIES
}

/** Return the canonical normalized Slack event payload schema. */
pub fn payload_schema() {
  return {
    harn_schema_name: "SlackEventPayload",
    json_schema: {
      type: "object",
      required: [
        "type",
        "event",
        "event_type",
        "resource_id",
        "channel",
        "user",
        "source",
        "source_refs",
        "triage",
        "provider_raw",
        "raw",
      ],
      additionalProperties: true,
      properties: {
        type: {type: "string", enum: ["event_callback"]},
        event_id: {type: ["string", "null"]},
        event_time: {type: ["integer", "number", "null"]},
        team_id: {type: ["string", "null"]},
        api_app_id: {type: ["string", "null"]},
        event: {type: "object"},
        event_type: {
          type: "string",
          enum: [
            "message",
            "app_mention",
            "reaction_added",
            "app_home_opened",
            "assistant_thread_started",
            "assistant_thread_context_changed",
            "slash_command",
            "interactivity",
          ],
        },
        resource_id: {type: "string"},
        channel: {type: "string"},
        thread_ts: {type: ["string", "null"]},
        user: {
          type: "object",
          required: ["id"],
          properties: {id: {type: "string"}, name: {type: ["string", "null"]}},
        },
        text: {type: ["string", "null"]},
        reaction: {type: ["string", "null"]},
        retry: {type: "object"},
        metrics: {type: "object"},
        occurred_at: {type: ["string", "integer", "number", "null"]},
        source: {type: "object"},
        source_refs: {type: "array"},
        triage: {type: "object"},
        provider_raw: {type: "object"},
        raw: {type: "object"},
      },
    },
  }
}

/** Initialize connector state with orchestrator context. */
pub fn init(ctx = nil) {
  let current = __state()
  let next = current + {initialized: true, ctx: ctx ?? {}}
  __set_state(next)
  return next
}

/** Activate webhook bindings and reject duplicate configured paths. */
pub fn activate(bindings = []) {
  var by_id = {}
  var seen_paths = {}
  for binding in bindings ?? [] {
    let binding_id = binding?.binding_id ?? binding?.id ?? "binding-" + to_string(len(by_id.keys()))
    let path = binding?.path ?? binding?.match?.path
    if path != nil && path != "" {
      if seen_paths.get(path) {
        return __err("activation", "slack connector path `" + path + "` is configured by multiple bindings")
      }
      seen_paths[path] = true
    }
    by_id[binding_id] = binding + {binding_id: binding_id}
  }
  let next = __state() + {bindings: by_id, active: true}
  __set_state(next)
  return {provider: SLACK_PROVIDER_ID, kind: "webhook", bindings: len(by_id.keys())}
}

/** Clear connector lifecycle state. */
pub fn shutdown() {
  SLACK_STATE = {initialized: false, active: false, bindings: {}, ctx: {}}
  return {provider: SLACK_PROVIDER_ID, active: false}
}

@complexity(allow)
/**
 * Verify and normalize a raw Slack Events API request.
 *
 * Slack requires a 200 response within 3 seconds. Keep this function CPU-only:
 * verify HMAC, parse JSON, return immediate_response, and never perform HTTP.
 */
pub fn normalize_inbound(raw) {
  let body_candidate = raw?.body_text ?? raw?.body
  if body_candidate == nil || to_string(body_candidate) == "" {
    return __reject({code: "missing_body_text", message: "slack webhook requires non-empty body_text"}, 400)
  }
  let body_text = to_string(body_candidate)
  let headers = raw?.headers ?? {}
  let verified = __verify_slack_signature(raw, headers, body_text)
  if is_err(verified) {
    return __reject(unwrap_err(verified), 403)
  }
  // Slash commands and interactivity payloads arrive as
  // `application/x-www-form-urlencoded` bodies signed with the same HMAC the
  // Events API path verifies above. Route them before the JSON parse.
  if __is_form_encoded(headers, body_text) {
    return __normalize_form_inbound(body_text, raw)
  }
  let parsed = try {
    json_parse(body_text)
  }
  if is_err(parsed) {
    return __reject({code: "invalid_json", message: "slack payload body is not valid JSON"}, 400)
  }
  let payload = unwrap(parsed)
  if payload?.type == "url_verification" {
    return {
      type: "immediate_response",
      immediate_response: {
        status: 200,
        body: payload?.challenge ?? "",
        headers: {"content-type": "text/plain; charset=utf-8"},
      },
    }
  }
  let normalized = __normalize_event_callback(payload, raw)
  if is_err(normalized) {
    return __reject(unwrap_err(normalized), 400)
  }
  let event = unwrap(normalized)
  if event == nil {
    return {
      type: "immediate_response",
      immediate_response: {status: 200, body: "", headers: {"content-type": "text/plain; charset=utf-8"}},
    }
  }
  return {type: "event", event: event}
}

/**
 * Open a Slack Socket Mode WebSocket using an app-level token, or a supplied
 * mock URL in tests.
 *
 * Security: Socket Mode is OFF by default. This is the only path that opens a
 * WebSocket, and it is never reached from `normalize_inbound` (the inbound hot
 * path is CPU-only and the effect policy denies network there). The connector
 * connects only when Socket Mode is explicitly enabled AND an app-level
 * `xapp-` token is present; otherwise callers should use the HTTP Events path.
 */
pub fn socket_mode_connect(args = {}) {
  let enabled = __socket_mode_enabled(args ?? {})
  if is_err(enabled) {
    return enabled
  }
  let socket_url = args?.socket_url ?? args?.url
  var resolved_url = socket_url
  if resolved_url == nil || trim(to_string(resolved_url)) == "" {
    let config = __socket_mode_config(args ?? {})
    if is_err(config) {
      return config
    }
    let cfg = unwrap(config)
    let response = try {
      harness.net
        .post(
        __slack_api_url(cfg.api_base_url, "apps.connections.open"),
        "{}",
        {
          headers: {Authorization: "Bearer " + cfg.app_token, "Content-Type": "application/json; charset=utf-8"},
        },
      )
    }
    if is_err(response) {
      return __err("transport", to_string(unwrap_err(response)))
    }
    let http_response = unwrap(response)
    let decoded = try {
      json_parse(http_response.body)
    }
    if is_err(decoded) {
      return __err("invalid_response", "Slack apps.connections.open returned invalid JSON")
    }
    let payload = unwrap(decoded)
    if http_response.status < 200 || http_response.status >= 300 || !(payload?.ok ?? false) {
      return __err(
        "slack_error",
        payload?.error
          ?? ("Slack apps.connections.open failed with status " + to_string(http_response.status)),
      )
    }
    resolved_url = payload?.url
  }
  if resolved_url == nil || trim(to_string(resolved_url)) == "" {
    return __err("missing_socket_url", "Slack Socket Mode requires socket_url or apps.connections.open url")
  }
  let options = {
    timeout_ms: args?.timeout_ms ?? 10000,
    max_messages: args?.max_messages ?? 1000,
    max_message_bytes: args?.max_message_bytes ?? 1048576,
  }
  let socket = websocket_connect(to_string(resolved_url), options)
  return {
    provider: SLACK_PROVIDER_ID,
    transport: "socket_mode",
    socket: socket,
    url: to_string(resolved_url),
  }
}

/**
 * Receive one Slack Socket Mode envelope, ack it immediately, and normalize its Events API payload.
 */
pub fn socket_mode_receive(connection, options = {}) {
  let socket = __socket_handle(connection)
  if socket == nil || trim(to_string(socket)) == "" {
    return __err("missing_socket", "Slack Socket Mode receive requires a socket handle")
  }
  let message = websocket_receive(to_string(socket), options?.timeout_ms ?? 1000)
  if message == nil || message?.type == "timeout" || message?.type == "close" {
    return {type: message?.type ?? "closed", message: message}
  }
  if message?.type != "text" {
    return {type: "ignored", reason: "non_text_socket_message", message: message}
  }
  let decoded = try {
    json_parse(message.data ?? "")
  }
  if is_err(decoded) {
    return __err("invalid_socket_envelope", "Slack Socket Mode envelope was not valid JSON")
  }
  let envelope = unwrap(decoded)
  let acked = __socket_mode_ack(to_string(socket), envelope)
  if is_err(acked) {
    return acked
  }
  let payload = envelope?.payload
  if payload == nil {
    return {type: "control", envelope: envelope, acked: unwrap(acked)}
  }
  let normalized = __normalize_event_callback(payload, options ?? {})
  if is_err(normalized) {
    return __reject(unwrap_err(normalized), 400)
  }
  var event = unwrap(normalized)
  if event == nil {
    return {
      type: "immediate_response",
      immediate_response: {status: 200, body: "", headers: {"content-type": "text/plain; charset=utf-8"}},
      envelope_id: envelope?.envelope_id,
      acked: unwrap(acked),
    }
  }
  event.payload = event.payload + {transport: "socket_mode", envelope_id: envelope?.envelope_id}
  return {type: "event", event: event, envelope_id: envelope?.envelope_id, acked: unwrap(acked)}
}

/** Ack a Slack Socket Mode envelope by id. */
pub fn socket_mode_ack(connection, envelope_id, payload = nil) {
  let socket = __socket_handle(connection)
  if socket == nil || trim(to_string(socket)) == "" {
    return __err("missing_socket", "Slack Socket Mode ack requires a socket handle")
  }
  var body = {envelope_id: envelope_id}
  if payload != nil {
    body["payload"] = payload
  }
  websocket_send(to_string(socket), json_stringify(body), {})
  return {acked: true, envelope_id: envelope_id}
}

@complexity(allow)
/** Dispatch a supported Slack Web API method with JSON body semantics. */
pub fn call(method, args = {}) {
  let slack_method = __canonical_outbound_method(method)
  let method_policy = __outbound_method_policy(slack_method)
  if method_policy == nil {
    return __err("method_not_found", "slack connector does not implement outbound method `" + method + "`")
  }
  var cfg = nil
  if slack_method == "apps.connections.open" {
    let config = __socket_mode_config(args ?? {})
    if is_err(config) {
      return config
    }
    let socket_cfg = unwrap(config)
    cfg = {api_base_url: socket_cfg.api_base_url, bot_token: socket_cfg.app_token}
  } else {
    let config = __outbound_config(args ?? {})
    if is_err(config) {
      return config
    }
    cfg = unwrap(config)
  }
  var body = __without_keys(
    args ?? {},
    [
      "api_base_url",
      "app_token",
      "bot_token",
      "token",
      "bot_token_secret",
      "app_token_secret",
      "secrets",
      "config",
      "metadata",
      "signing_secret",
      "secret",
      "webhook_secret",
      "signing_secret_id",
      "signing_secret_secret",
      "webhook_secret_id",
      "webhook_secret_secret",
      "secret_id",
      "include_bot_messages",
      "_harn",
      "harn",
      "disclosure",
      "slack_disclosure",
      "actor_chain",
      "disclosure_options",
      "granted_scopes",
      "oauth_scopes",
      "token_scopes",
      "scopes",
    ],
  )
  if slack_method == "users.info" && body?.user == nil && body?.user_id != nil {
    body["user"] = body.user_id
    body = body.remove("user_id")
  }
  body = __apply_slack_outbound_disclosure(slack_method, body, args ?? {})
  let response = try {
    harness.net
      .post(
      __slack_api_url(cfg.api_base_url, slack_method),
      json_stringify(body),
      {
        headers: {Authorization: "Bearer " + cfg.bot_token, "Content-Type": "application/json; charset=utf-8"},
      },
    )
  }
  if is_err(response) {
    return __err("transport", to_string(unwrap_err(response)))
  }
  let http_response = unwrap(response)
  let decoded = try {
    json_parse(http_response.body)
  }
  if is_err(decoded) {
    return __err("invalid_response", "Slack API method `" + method + "` returned invalid JSON")
  }
  let payload = unwrap(decoded)
  if http_response.status < 200 || http_response.status >= 300 {
    if payload?.error != nil {
      return __slack_api_error(slack_method, payload, http_response.status)
    }
    return __err("transport", "Slack API request failed with status " + to_string(http_response.status))
  }
  if !(payload?.ok ?? false) {
    return __slack_api_error(slack_method, payload, http_response.status)
  }
  return payload
}

fn __canonical_outbound_method(method) {
  let aliases = {
    post_message: "chat.postMessage",
    update_message: "chat.update",
    add_reaction: "reactions.add",
    open_view: "views.open",
    user_info: "users.info",
  }
  return aliases.get(method) ?? method
}

fn __apply_slack_outbound_disclosure(method, body, args) {
  let disclosure = __slack_message_disclosure(args)
  var out = __strip_ungranted_slack_custom_identity(method, body, args, disclosure)
  if disclosure == nil || disclosure?.enabled == false {
    return out
  }
  if __slack_can_customize_identity(method, args, disclosure) {
    out = __apply_slack_custom_identity(out, disclosure)
  } else {
    out = __apply_slack_textual_byline(out, disclosure)
  }
  return __apply_slack_ai_mark(out, disclosure)
}

fn __slack_message_disclosure(args) {
  return args?._harn?.disclosure?.slack
    ?? args?._harn?.slack_disclosure
    ?? args?.disclosure?.slack
    ?? args?.slack_disclosure
}

fn __strip_ungranted_slack_custom_identity(method, body, args, disclosure) {
  if method != "chat.postMessage" || __slack_customize_scope_granted(args, disclosure) {
    return body
  }
  return body.remove("username").remove("icon_url").remove("icon_emoji")
}

fn __slack_can_customize_identity(method, args, disclosure) {
  return method == "chat.postMessage"
    && disclosure?.customize?.enabled != false
    && __slack_customize_scope_granted(args, disclosure)
}

fn __slack_customize_scope_granted(args, disclosure) {
  return __has_scope(__slack_scope_candidates(args, disclosure), SLACK_CUSTOMIZE_SCOPE)
}

fn __slack_scope_candidates(args, disclosure) {
  return [
    disclosure?.customize?.granted_scopes,
    disclosure?.granted_scopes,
    args?.granted_scopes,
    args?.oauth_scopes,
    args?.token_scopes,
    args?.scopes,
    args?.config?.granted_scopes,
    args?.config?.oauth_scopes,
    args?.metadata?.granted_scopes,
    args?.metadata?.oauth_scopes,
    __state()?.ctx?.granted_scopes,
    __state()?.ctx?.oauth_scopes,
  ]
}

fn __has_scope(candidates, scope) {
  let wanted = lowercase(trim(scope))
  for candidate in candidates ?? [] {
    if __candidate_has_scope(candidate, wanted) {
      return true
    }
  }
  return false
}

fn __candidate_has_scope(candidate, wanted) {
  if candidate == nil {
    return false
  }
  if type_of(candidate) == "list" {
    for item in candidate {
      if lowercase(trim(to_string(item))) == wanted {
        return true
      }
    }
    return false
  }
  let normalized = regex_replace("[,\\s]+", " ", lowercase(trim(to_string(candidate))))
  return contains(split(normalized, " "), wanted)
}

fn __apply_slack_custom_identity(body, disclosure) {
  let customize = disclosure?.customize ?? {}
  var out = body
  if customize?.username != nil && trim(to_string(customize.username)) != "" {
    out["username"] = to_string(customize.username)
  }
  if customize?.icon_url != nil && trim(to_string(customize.icon_url)) != "" {
    out["icon_url"] = to_string(customize.icon_url)
  }
  if customize?.icon_emoji != nil && trim(to_string(customize.icon_emoji)) != "" {
    out["icon_emoji"] = to_string(customize.icon_emoji)
  }
  return out
}

fn __apply_slack_textual_byline(body, disclosure) {
  let byline = trim(to_string(disclosure?.byline ?? disclosure?.text ?? ""))
  if byline == "" {
    return body
  }
  var out = __prepend_slack_text(body, byline)
  if type_of(out?.blocks) == "list" && len(out.blocks) > 0
    && !__slack_blocks_contain_text(out.blocks, byline) {
    out["blocks"] = [__slack_byline_block(byline)] + out.blocks
  }
  return out
}

fn __prepend_slack_text(body, byline) {
  let text = to_string(body?.text ?? "")
  if trim(text) == "" || __text_contains_line(text, byline) {
    return body
  }
  return body + {text: byline + "\n\n" + text}
}

fn __text_contains_line(text, line) {
  let wanted = trim(line)
  for existing in split(to_string(text), "\n") {
    if trim(existing) == wanted {
      return true
    }
  }
  return false
}

fn __slack_byline_block(byline) {
  return {type: "context", elements: [{type: "mrkdwn", text: byline}]}
}

fn __slack_blocks_contain_text(blocks, text) {
  let wanted = trim(text)
  for block in blocks ?? [] {
    if trim(to_string(block?.text?.text ?? "")) == wanted {
      return true
    }
    for element in block?.elements ?? [] {
      if trim(to_string(element?.text ?? "")) == wanted {
        return true
      }
    }
  }
  return false
}

fn __apply_slack_ai_mark(body, disclosure) {
  let mark = disclosure?.ai_mark ?? disclosure?.mark ?? {}
  if mark?.enabled == false {
    return body
  }
  let payload = mark?.event_payload ?? mark?.payload
  if payload == nil {
    return body
  }
  let event_type = to_string(mark?.event_type ?? "harn.ai_disclosure.v1")
  var metadata = body?.metadata ?? {}
  if metadata?.event_type == nil || trim(to_string(metadata.event_type)) == "" {
    metadata["event_type"] = event_type
  }
  var event_payload = metadata?.event_payload ?? {}
  var harn = event_payload?.harn ?? {}
  harn["ai_disclosure"] = payload
  event_payload["harn"] = harn
  metadata["event_payload"] = event_payload
  return body + {metadata: metadata}
}

/**
 * Build a Slack `chat.postMessage` payload for an upstream eval verdict.
 *
 * The verdict is already computed by Harn's eval stats module; this helper only
 * formats the digest and carries caller-supplied Slack options through to
 * `chat.postMessage`.
 */
pub fn eval_verdict_post_message_payload(verdict, options = nil) {
  let opts = options ?? {}
  let channel = opts?.channel ?? verdict?.channel
  if channel == nil || trim(to_string(channel)) == "" {
    return __err("missing_channel", "eval verdict Slack digest requires channel")
  }
  let title = __eval_verdict_title(verdict)
  let summary = __eval_verdict_summary(verdict)
  var payload = opts
    + {
    channel: channel,
    text: title + "\n" + summary,
    blocks: [
      {type: "section", text: {type: "mrkdwn", text: "*" + title + "*\n" + summary}},
      {type: "section", fields: __eval_verdict_fields(verdict)},
    ],
  }
  let cases = __eval_verdict_case_lines(verdict?.top_regressed_cases ?? verdict?.regressed_cases ?? [], 5)
  if cases != "" {
    payload.blocks = payload.blocks
      .push({type: "section", text: {type: "mrkdwn", text: "*Top regressed cases*\n" + cases}})
  }
  let link = verdict?.dashboard_url ?? verdict?.ledger_url ?? verdict?.run_url
  if link != nil && trim(to_string(link)) != "" {
    payload.blocks = payload.blocks
      .push(
      {type: "context", elements: [{type: "mrkdwn", text: "<" + to_string(link) + "|Open eval ledger>"}]},
    )
  }
  return payload
}

/** Format and post an upstream eval verdict through `chat.postMessage`. */
pub fn post_eval_verdict(verdict, options = nil) {
  let payload = eval_verdict_post_message_payload(verdict, options)
  if is_err(payload) {
    return payload
  }
  return call("chat.postMessage", unwrap(payload))
}

fn __state() {
  return SLACK_STATE
}

fn __set_state(state) {
  SLACK_STATE = state
  return state
}

fn __outbound_method_policy(method) {
  for policy in SLACK_OUTBOUND_METHOD_POLICIES {
    if policy.method == method {
      return policy
    }
  }
  return nil
}

fn __err(code, message, details = nil) {
  var error = {code: code, message: message}
  if details != nil {
    error["details"] = details
  }
  return Err(error)
}

fn __without_keys(input, keys) {
  var out = input ?? {}
  for key in keys ?? [] {
    out = out.remove(key)
  }
  return out
}

fn __slack_api_error(method, payload, status = nil) {
  let slack_error = to_string(payload?.error ?? "slack_error")
  let details = {
    method: method,
    status: status,
    slack_error: slack_error,
    needed: payload?.needed,
    provided: payload?.provided,
  }
  if contains(
    [
      "not_authed",
      "invalid_auth",
      "token_revoked",
      "account_inactive",
      "missing_scope",
      "no_permission",
    ],
    slack_error,
  ) {
    return __err(
      slack_error,
      "Slack API method `" + method + "` failed auth/scope check: " + slack_error,
      details,
    )
  }
  return __err("slack_error", slack_error, details)
}

fn __reject(error, status = 400) {
  return {
    type: "reject",
    reject: {
      status: status,
      headers: {"content-type": "application/json; charset=utf-8"},
      body: {error: error?.code ?? "rejected", message: error?.message ?? to_string(error)},
    },
  }
}

fn __header(headers, name) {
  let wanted = lowercase(name)
  for entry in (headers ?? {}).entries() {
    if lowercase(trim(to_string(entry.key))) == wanted {
      return trim(to_string(entry.value))
    }
  }
  return nil
}

fn __canonical_slack_headers(headers) {
  var canonical = {}
  for pair in [
    {raw: "content-type", canonical: "Content-Type"},
    {raw: "x-slack-signature", canonical: "X-Slack-Signature"},
    {raw: "x-slack-request-timestamp", canonical: "X-Slack-Request-Timestamp"},
    {raw: "x-slack-retry-num", canonical: "X-Slack-Retry-Num"},
    {raw: "x-slack-retry-reason", canonical: "X-Slack-Retry-Reason"},
  ] {
    let value = __header(headers, pair.raw)
    if value != nil && value != "" {
      canonical[pair.canonical] = if pair.raw == "x-slack-signature" {
        SLACK_REDACTED_HEADER_VALUE
      } else {
        value
      }
    }
  }
  return canonical
}

fn __slack_retry(headers) {
  let retry_num_raw = __header(headers, "x-slack-retry-num")
  let retry_reason = __header(headers, "x-slack-retry-reason")
  var retry_num = nil
  if retry_num_raw != nil && retry_num_raw != "" {
    let parsed = try {
      to_int(retry_num_raw)
    }
    if !is_err(parsed) {
      retry_num = unwrap(parsed)
    }
  }
  return {
    is_retry: (retry_num_raw != nil && retry_num_raw != "") || (retry_reason != nil && retry_reason != ""),
    num: retry_num,
    num_raw: retry_num_raw,
    reason: retry_reason,
    headers: {"x-slack-retry-num": retry_num_raw, "x-slack-retry-reason": retry_reason},
  }
}

fn __slack_metrics(retry_info) {
  if retry_info?.is_retry ?? false {
    return {slack_retry_delivery: 1, slack_first_delivery: 0, slack_retry_num: retry_info?.num ?? 0}
  }
  return {slack_retry_delivery: 0, slack_first_delivery: 1, slack_retry_num: 0}
}

fn __signing_secret(raw) {
  let direct = __first_secret_value(
    [
      raw?.signing_secret,
      raw?.secret,
      raw?.webhook_secret,
      raw?.metadata?.signing_secret,
      raw?.metadata?.secret,
      raw?.metadata?.webhook_secret,
      raw?.config?.signing_secret,
      raw?.config?.webhook_secret,
      raw?.secrets?.signing_secret,
      raw?.secrets?.webhook_secret,
      raw?.metadata?.secrets?.signing_secret,
      raw?.metadata?.secrets?.webhook_secret,
    ],
    nil,
  )
  if direct != nil && trim(to_string(direct)) != "" {
    return to_string(direct)
  }
  let state = __state()
  let ctx_secret = __first_secret_value(
    [
      state.ctx?.signing_secret,
      state.ctx?.webhook_secret,
      state.ctx?.secrets?.signing_secret,
      state.ctx?.secrets?.webhook_secret,
    ],
    nil,
  )
  if ctx_secret != nil && trim(to_string(ctx_secret)) != "" {
    return to_string(ctx_secret)
  }
  let bindings = state.bindings ?? {}
  let binding_id = raw?.metadata?.binding_id ?? raw?.binding_id
  if binding_id != nil {
    let binding_secret = __binding_signing_secret(bindings.get(binding_id))
    if binding_secret != nil && trim(to_string(binding_secret)) != "" {
      return binding_secret
    }
  }
  let values = bindings.values()
  if len(values) == 1 {
    let binding_secret = __binding_signing_secret(values[0])
    if binding_secret != nil && trim(to_string(binding_secret)) != "" {
      return binding_secret
    }
  }
  let secret_id = __signing_secret_id(raw)
  let secret = __secret_get_optional(secret_id)
  if secret != nil && trim(to_string(secret)) != "" {
    return secret
  }
  return nil
}

fn __binding_signing_secret(binding) {
  return __first_secret_value(
    [
      binding?.signing_secret,
      binding?.webhook_secret,
      binding?.secrets?.signing_secret,
      binding?.secrets?.webhook_secret,
      binding?.config?.signing_secret,
      binding?.config?.webhook_secret,
      binding?.config?.secrets?.signing_secret,
      binding?.config?.secrets?.webhook_secret,
    ],
    nil,
  )
}

fn __signing_secret_id(raw) {
  let metadata = raw?.metadata ?? {}
  let direct_id = __first_secret_id(
    [
      raw?.signing_secret_id,
      raw?.signing_secret_secret,
      raw?.webhook_secret_id,
      raw?.webhook_secret_secret,
      raw?.secret_id,
      raw?.config?.signing_secret_id,
      raw?.config?.signing_secret_secret,
      raw?.config?.webhook_secret_id,
      raw?.config?.webhook_secret_secret,
      raw?.config?.secret_ids?.signing_secret,
      raw?.config?.secret_ids?.webhook_secret,
      raw?.secrets?.signing_secret_id,
      raw?.secrets?.webhook_secret_id,
      metadata?.signing_secret_id,
      metadata?.signing_secret_secret,
      metadata?.webhook_secret_id,
      metadata?.webhook_secret_secret,
      metadata?.secret_ids?.signing_secret,
      metadata?.secret_ids?.webhook_secret,
      metadata?.config?.secret_ids?.signing_secret,
      metadata?.config?.secret_ids?.webhook_secret,
    ],
  )
  if direct_id != nil {
    return direct_id
  }
  let bindings = __state().bindings ?? {}
  let binding_id = metadata?.binding_id ?? raw?.binding_id
  if binding_id != nil {
    return __binding_signing_secret_id(bindings.get(binding_id))
  }
  let values = bindings.values()
  if len(values) == 1 {
    return __binding_signing_secret_id(values[0])
  }
  return "slack/signing-secret"
}

fn __binding_signing_secret_id(binding) {
  return __first_secret_id(
    [
      binding?.signing_secret_id,
      binding?.signing_secret_secret,
      binding?.webhook_secret_id,
      binding?.webhook_secret_secret,
      binding?.secrets?.signing_secret_id,
      binding?.secrets?.webhook_secret_id,
      binding?.config?.signing_secret_id,
      binding?.config?.signing_secret_secret,
      binding?.config?.webhook_secret_id,
      binding?.config?.webhook_secret_secret,
      binding?.config?.secret_ids?.signing_secret,
      binding?.config?.secret_ids?.webhook_secret,
      binding?.config?.secrets?.signing_secret,
      binding?.config?.secrets?.webhook_secret,
    ],
  )
}

fn __first_secret_value(candidates, fallback_id = nil) {
  for candidate in candidates ?? [] {
    let value = __secret_value_optional(candidate, nil)
    if value != nil && trim(to_string(value)) != "" {
      return value
    }
  }
  return __secret_get_optional(fallback_id)
}

fn __first_secret_id(candidates) {
  for candidate in candidates ?? [] {
    let id = __secret_id_candidate(candidate)
    if id != nil && trim(to_string(id)) != "" {
      return id
    }
  }
  return nil
}

fn __secret_id_candidate(value) {
  if value == nil || trim(to_string(value)) == "" {
    return nil
  }
  return trim(to_string(value))
}

fn __secret_value_optional(value, fallback_id = nil) {
  if value != nil && trim(to_string(value)) != "" {
    let raw = trim(to_string(value))
    if contains(raw, "/") {
      let resolved = __secret_get_optional(raw)
      if resolved != nil && trim(to_string(resolved)) != "" {
        return resolved
      }
    }
    return raw
  }
  return __secret_get_optional(fallback_id)
}

fn __secret_get_optional(secret_id) {
  if secret_id == nil || trim(to_string(secret_id)) == "" {
    return nil
  }
  let resolved = try {
    secret_get(to_string(secret_id))
  }
  if is_err(resolved) {
    return nil
  }
  return to_string(unwrap(resolved))
}

fn __include_bot_messages(raw) {
  // Security: read from binding/ctx only — never from the attacker-controlled
  // raw envelope. The binding-id lookup is the only raw-derived hop, and only
  // selects a trusted binding entry.
  let state = __state()
  let bindings = state.bindings ?? {}
  let binding_id = raw?.metadata?.binding_id ?? raw?.binding_id
  if binding_id != nil {
    let binding = bindings.get(binding_id)
    let from_binding = binding?.include_bot_messages ?? binding?.config?.include_bot_messages
    if from_binding != nil {
      return from_binding
    }
  }
  return state.ctx?.include_bot_messages ?? false
}

fn __verify_slack_signature(raw, headers, body_text) {
  let signature = __header(headers, "x-slack-signature")
  if signature == nil || signature == "" {
    return __err("missing_signature", "missing x-slack-signature header")
  }
  let request_ts = __header(headers, "x-slack-request-timestamp")
  if request_ts == nil || request_ts == "" {
    return __err("missing_timestamp", "missing x-slack-request-timestamp header")
  }
  let parsed_ts = try {
    to_int(trim(request_ts))
  }
  if is_err(parsed_ts) {
    return __err("invalid_timestamp", "x-slack-request-timestamp is not an integer")
  }
  let ts = unwrap(parsed_ts)
  if ts == nil {
    return __err("invalid_timestamp", "x-slack-request-timestamp is not an integer")
  }
  // Security: derive `now` from the trusted clock only. Reading `raw.now`,
  // `raw.metadata.now`, or `raw.received_at` lets the caller bypass the
  // 5-minute replay window by claiming a stale request just arrived.
  let now = date_now().timestamp
  if abs(now - ts) > SLACK_SIGNATURE_WINDOW_SECONDS {
    return __err(
      "expired_timestamp",
      "x-slack-request-timestamp is outside the allowed 5 minute verification window",
    )
  }
  let secret = __signing_secret(raw)
  if secret == nil || trim(to_string(secret)) == "" {
    return __err("missing_secret", "slack signing_secret is required")
  }
  let basestring = "v0:" + to_string(ts) + ":" + body_text
  let expected = "v0=" + hmac_sha256(to_string(secret), basestring)
  if !constant_time_eq(expected, signature) {
    return __err("invalid_signature", "x-slack-signature did not match the request body")
  }
  return Ok(true)
}

@complexity(allow)
fn __normalize_event_callback(payload, raw) {
  if payload?.type != "event_callback" {
    return __err("unsupported_payload", "unsupported Slack payload type `" + to_string(payload?.type) + "`")
  }
  let event = payload?.event
  if event == nil {
    return __err("missing_event", "slack event_callback missing event")
  }
  let event_type = event?.type
  if event_type == nil || event_type == "" {
    return __err("missing_event_type", "slack event missing type")
  }
  if event_type == "message" && event?.bot_id != nil && !__include_bot_messages(raw) {
    return nil
  }
  let retry_info = __slack_retry(raw?.headers ?? {})
  if event_type == "message" || event_type == "app_mention" {
    let channel = event?.channel ?? ""
    let ts = event?.ts ?? event?.event_ts ?? ""
    let resource_id = channel + "/" + ts
    let dedupe_key = __dedupe_key(payload, event_type, resource_id)
    let normalized_payload = __payload_with_normalized_fields(
      payload,
      {
        provider: SLACK_PROVIDER_ID,
        event_type: event_type,
        resource_id: resource_id,
        channel: channel,
        channel_type: event?.channel_type,
        message_ts: ts,
        thread_ts: event?.thread_ts ?? ts,
        user: {id: event?.user ?? "", name: event?.user_name ?? event?.username},
        text: event?.text ?? "",
        retry: retry_info,
        metrics: __slack_metrics(retry_info),
        occurred_at: event?.event_ts ?? event?.ts ?? payload?.event_time,
        raw: event,
      },
      raw,
      dedupe_key,
    )
    return __event_result(
      event_type,
      dedupe_key,
      normalized_payload,
      __canonical_slack_headers(raw?.headers ?? {}),
    )
  }
  if event_type == "reaction_added" {
    let item = event?.item ?? {}
    let channel = item?.channel ?? event?.channel ?? ""
    let ts = item?.ts ?? event?.event_ts ?? ""
    let resource_id = channel + "/" + ts
    let dedupe_key = __dedupe_key(payload, event_type, resource_id)
    let normalized_payload = __payload_with_normalized_fields(
      payload,
      {
        provider: SLACK_PROVIDER_ID,
        event_type: event_type,
        resource_id: resource_id,
        channel: channel,
        channel_type: event?.channel_type,
        item_type: item?.type,
        message_ts: item?.ts,
        thread_ts: item?.ts,
        user: {id: event?.user ?? "", name: event?.user_name ?? event?.username},
        item_user: event?.item_user,
        text: event?.reaction ?? "",
        reaction: event?.reaction ?? "",
        retry: retry_info,
        metrics: __slack_metrics(retry_info),
        occurred_at: event?.event_ts ?? payload?.event_time,
        raw: event,
      },
      raw,
      dedupe_key,
    )
    return __event_result(
      event_type,
      dedupe_key,
      normalized_payload,
      __canonical_slack_headers(raw?.headers ?? {}),
    )
  }
  if event_type == "app_home_opened" {
    let channel = event?.channel ?? ""
    let ts = event?.event_ts ?? payload?.event_time ?? ""
    var resource_base = event?.user ?? ""
    if channel != "" {
      resource_base = channel
    }
    let resource_id = resource_base + "/" + to_string(ts)
    let dedupe_key = __dedupe_key(payload, event_type, resource_id)
    let normalized_payload = __payload_with_normalized_fields(
      payload,
      {
        provider: SLACK_PROVIDER_ID,
        event_type: event_type,
        resource_id: resource_id,
        channel: channel,
        channel_type: event?.channel_type,
        message_ts: nil,
        thread_ts: nil,
        user: {id: event?.user ?? "", name: event?.user_name ?? event?.username},
        text: "",
        tab: event?.tab,
        view: event?.view,
        retry: retry_info,
        metrics: __slack_metrics(retry_info),
        occurred_at: event?.event_ts ?? payload?.event_time,
        raw: event,
      },
      raw,
      dedupe_key,
    )
    return __event_result(
      event_type,
      dedupe_key,
      normalized_payload,
      __canonical_slack_headers(raw?.headers ?? {}),
    )
  }
  if event_type == "assistant_thread_started" {
    let assistant_thread = event?.assistant_thread ?? {}
    let channel = assistant_thread?.channel_id ?? assistant_thread?.context?.channel_id ?? event?.channel ?? ""
    let thread_ts = assistant_thread?.thread_ts ?? event?.event_ts
    let resource_id = channel + "/" + to_string(thread_ts ?? "")
    let dedupe_key = __dedupe_key(payload, event_type, resource_id)
    let normalized_payload = __payload_with_normalized_fields(
      payload,
      {
        provider: SLACK_PROVIDER_ID,
        event_type: event_type,
        resource_id: resource_id,
        channel: channel,
        channel_type: event?.channel_type,
        message_ts: thread_ts,
        thread_ts: thread_ts,
        user: {id: assistant_thread?.user_id ?? event?.user ?? "", name: event?.user_name ?? event?.username},
        text: "",
        assistant_thread: assistant_thread,
        context: assistant_thread?.context,
        retry: retry_info,
        metrics: __slack_metrics(retry_info),
        occurred_at: event?.event_ts ?? payload?.event_time,
        raw: event,
      },
      raw,
      dedupe_key,
    )
    return __event_result(
      event_type,
      dedupe_key,
      normalized_payload,
      __canonical_slack_headers(raw?.headers ?? {}),
    )
  }
  if event_type == "assistant_thread_context_changed" {
    let assistant_thread = event?.assistant_thread ?? {}
    let channel = assistant_thread?.channel_id ?? assistant_thread?.context?.channel_id ?? event?.channel ?? ""
    let thread_ts = assistant_thread?.thread_ts ?? event?.event_ts
    let resource_id = channel + "/" + to_string(thread_ts ?? "")
    let dedupe_key = __dedupe_key(payload, event_type, resource_id)
    let normalized_payload = __payload_with_normalized_fields(
      payload,
      {
        provider: SLACK_PROVIDER_ID,
        event_type: event_type,
        resource_id: resource_id,
        channel: channel,
        channel_type: event?.channel_type,
        message_ts: thread_ts,
        thread_ts: thread_ts,
        user: {id: assistant_thread?.user_id ?? event?.user ?? "", name: event?.user_name ?? event?.username},
        text: "",
        assistant_thread: assistant_thread,
        context: assistant_thread?.context,
        retry: retry_info,
        metrics: __slack_metrics(retry_info),
        occurred_at: event?.event_ts ?? payload?.event_time,
        raw: event,
      },
      raw,
      dedupe_key,
    )
    return __event_result(
      event_type,
      dedupe_key,
      normalized_payload,
      __canonical_slack_headers(raw?.headers ?? {}),
    )
  }
  return __err("unsupported_event", "unsupported Slack event type `" + to_string(event_type) + "`")
}

/**
 * Detect `application/x-www-form-urlencoded` slash-command/interactivity
 * bodies. Falls back to body sniffing when the content-type header is absent
 * (Slack always sends the header, but tests and proxies may omit it).
 */
fn __is_form_encoded(headers, body_text) {
  let content_type = lowercase(to_string(__header(headers, "content-type") ?? ""))
  if contains(content_type, "application/x-www-form-urlencoded") {
    return true
  }
  if content_type != "" {
    return false
  }
  let trimmed = trim(to_string(body_text ?? ""))
  if trimmed == "" || trimmed.starts_with("{") || trimmed.starts_with("[") {
    return false
  }
  return contains(trimmed, "=") && !contains(trimmed, "\n")
}

/** Parse a urlencoded body into a flat dict of first-wins string fields. */
fn __form_fields(body_text) {
  let parsed = try {
    query_parse(to_string(body_text ?? ""))
  }
  if is_err(parsed) {
    return __err("invalid_form_body", "slack form body could not be parsed")
  }
  var fields = {}
  for pair in unwrap(parsed) ?? [] {
    let key = to_string(pair?.key ?? "")
    if key != "" && fields.get(key) == nil {
      fields[key] = pair?.value
    }
  }
  return Ok(fields)
}

/**
 * Normalize a urlencoded Slack POST into either a `slash_command` or
 * `interactivity` envelope. Interactivity payloads carry a `payload=<json>`
 * field; slash commands carry flat `command`/`text`/... fields.
 */
fn __normalize_form_inbound(body_text, raw) {
  let fields_result = __form_fields(body_text)
  if is_err(fields_result) {
    return __reject(unwrap_err(fields_result), 400)
  }
  let fields = unwrap(fields_result)
  if fields.get("payload") != nil {
    return __normalize_interactivity(to_string(fields.payload), raw)
  }
  return __normalize_slash_command(fields, raw)
}

/** Normalize a Slack slash-command form POST into a `slash_command` envelope. */
fn __normalize_slash_command(fields, raw) {
  let command = to_string(fields?.command ?? "")
  let text = to_string(fields?.text ?? "")
  let channel = to_string(fields?.channel_id ?? "")
  let user_id = to_string(fields?.user_id ?? "")
  let team_id = fields?.team_id ?? fields?.team_domain
  let trigger_id = fields?.trigger_id
  let response_url = fields?.response_url
  let resource_id = channel + "/" + command
  let dedupe_key = if trigger_id != nil && trim(to_string(trigger_id)) != "" {
    "slack:slash:" + to_string(trigger_id)
  } else {
    "slack:slash:" + to_string(team_id ?? "unknown-team") + ":" + channel + ":" + command
  }
  let normalized = {
    provider: SLACK_PROVIDER_ID,
    event_type: "slash_command",
    resource_id: resource_id,
    channel: channel,
    channel_type: __slash_channel_type(channel, fields),
    message_ts: nil,
    thread_ts: nil,
    user: {id: user_id, name: fields?.user_name},
    text: text,
    command: command,
    response_url: response_url,
    trigger_id: trigger_id,
    api_app_id: fields?.api_app_id,
    enterprise_id: fields?.enterprise_id,
    raw: fields,
  }
  let envelope = {
    type: "event_callback",
    event_id: nil,
    event_time: nil,
    team_id: team_id,
    api_app_id: fields?.api_app_id,
    enterprise_id: fields?.enterprise_id,
  }
  let normalized_payload = __payload_with_normalized_fields(envelope, normalized, raw, dedupe_key)
  let payload = normalized_payload
    + {agent_summon: __agent_summon(normalized, normalized_payload?.source, "slash_command")}
  return {
    type: "event",
    event: __event_result("slash_command", dedupe_key, payload, __canonical_slack_headers(raw?.headers ?? {})),
  }
}

/** Normalize a Slack interactivity `payload=<json>` POST into an `interactivity` envelope. */
fn __normalize_interactivity(payload_json, raw) {
  let parsed = try {
    json_parse(payload_json)
  }
  if is_err(parsed) {
    return __reject(
      {code: "invalid_interactivity_payload", message: "slack interactivity payload is not valid JSON"},
      400,
    )
  }
  let payload = unwrap(parsed)
  let interaction_type = to_string(payload?.type ?? "")
  let channel = to_string(payload?.channel?.id ?? payload?.container?.channel_id ?? "")
  let user_id = to_string(payload?.user?.id ?? "")
  let team_id = payload?.team?.id ?? payload?.user?.team_id
  let thread_ts = payload?.message?.thread_ts ?? payload?.container?.thread_ts
  let action_id = __interactivity_action_id(payload)
  let resource_base = if action_id != nil && action_id != "" {
    action_id
  } else {
    interaction_type
  }
  let resource_id = channel + "/" + to_string(resource_base)
  let dedupe_key = if payload?.trigger_id != nil && trim(to_string(payload.trigger_id)) != "" {
    "slack:interactivity:" + to_string(payload.trigger_id)
  } else {
    "slack:interactivity:" + to_string(team_id ?? "unknown-team") + ":" + channel + ":"
      + to_string(resource_base)
  }
  let normalized = {
    provider: SLACK_PROVIDER_ID,
    event_type: "interactivity",
    resource_id: resource_id,
    channel: channel,
    channel_type: payload?.channel?.channel_type,
    message_ts: payload?.message?.ts,
    thread_ts: thread_ts,
    user: {id: user_id, name: payload?.user?.username ?? payload?.user?.name},
    text: "",
    interaction_type: interaction_type,
    action_id: action_id,
    callback_id: payload?.view?.callback_id ?? payload?.callback_id,
    response_url: payload?.response_url,
    trigger_id: payload?.trigger_id,
    api_app_id: payload?.api_app_id,
    view: payload?.view,
    actions: payload?.actions,
    raw: payload,
  }
  let envelope = {
    type: "event_callback",
    event_id: nil,
    event_time: nil,
    team_id: team_id,
    api_app_id: payload?.api_app_id,
    enterprise_id: payload?.enterprise?.id,
  }
  let normalized_payload = __payload_with_normalized_fields(envelope, normalized, raw, dedupe_key)
  return {
    type: "event",
    event: __event_result(
      "interactivity",
      dedupe_key,
      normalized_payload,
      __canonical_slack_headers(raw?.headers ?? {}),
    ),
  }
}

/** Resolve the first block-action id from an interactivity payload, if any. */
fn __interactivity_action_id(payload) {
  let actions = payload?.actions ?? []
  if len(actions) > 0 {
    return actions[0]?.action_id ?? actions[0]?.block_id
  }
  return nil
}

/** Classify a slash-command channel by id prefix when channel_type is absent. */
fn __slash_channel_type(channel, fields) {
  let declared = fields?.channel_type
  if declared != nil && trim(to_string(declared)) != "" {
    return to_string(declared)
  }
  if starts_with(to_string(channel), "D") {
    return "im"
  }
  if starts_with(to_string(channel), "G") {
    return "group"
  }
  return nil
}

fn __event_result(kind, dedupe_key, payload, headers = nil) {
  return {
    kind: kind,
    dedupe_key: dedupe_key,
    payload: payload,
    headers: headers,
    signature_status: {state: "verified"},
  }
}

/**
 * Classify a Slack channel into the canonical agent_summon channel_kind:
 * `public` | `private` | `im` | `mpim`. Prefers Slack `channel_type`, then
 * falls back to channel-id prefixes (D=im, G/C may be private/public/mpim).
 */
fn __agent_channel_kind(channel_type, channel_id) {
  let declared = to_string(channel_type ?? "")
  if declared == "im" {
    return "im"
  }
  if declared == "mpim" {
    return "mpim"
  }
  if declared == "group" || declared == "private_channel" {
    return "private"
  }
  if declared == "channel" || declared == "public_channel" {
    return "public"
  }
  let id = to_string(channel_id ?? "")
  if starts_with(id, "D") {
    return "im"
  }
  if starts_with(id, "G") {
    return "private"
  }
  return "public"
}

/**
 * Build the canonical `agent_summon` dispatch envelope shared by harn-cloud
 * (Slack dispatch) and burin-code (local Socket Mode). All summon-capable
 * triggers — `app_mention`, DM/group-DM `message`, and `slash_command` —
 * normalize into this one shape. See the README for the contract.
 */
fn __agent_summon(normalized, source, trigger_kind) {
  let channel_id = to_string(normalized?.channel ?? "")
  let channel_kind = __agent_channel_kind(normalized?.channel_type, channel_id)
  let visibility = if channel_kind == "im" || channel_kind == "mpim" || channel_kind == "private" {
    "private"
  } else {
    "public"
  }
  return {
    prompt: to_string(normalized?.text ?? ""),
    channel_id: channel_id,
    channel_kind: channel_kind,
    thread_ts: normalized?.thread_ts ?? normalized?.message_ts,
    user: normalized?.user?.id,
    team: source?.team_id,
    visibility: visibility,
    trigger_kind: trigger_kind,
  }
}

/**
 * Decide whether an event_type/channel pairing is a summon and, if so, the
 * canonical trigger_kind. Returns nil for non-summon events.
 */
fn __agent_summon_trigger_kind(event_type, channel_type, channel_id) {
  if event_type == "app_mention" {
    return "app_mention"
  }
  if event_type == "message" {
    let kind = __agent_channel_kind(channel_type, channel_id)
    if kind == "im" {
      return "message.im"
    }
    if kind == "mpim" {
      return "message.mpim"
    }
  }
  return nil
}

fn __dedupe_key(payload, event_type, resource_id) {
  let event_id = payload?.event_id
  if event_id != nil && trim(to_string(event_id)) != "" {
    return "slack:event:" + to_string(event_id)
  }
  let team = payload?.team_id ?? payload?.event?.team ?? "unknown-team"
  return "slack:" + to_string(team) + ":" + event_type + ":" + resource_id
}

fn __payload_with_normalized_fields(payload, normalized, raw = nil, dedupe_key = nil) {
  let base = payload ?? {}
  let provider_raw = {envelope: payload, event: normalized?.raw, headers: __canonical_slack_headers(raw?.headers ?? {})}
  let source = __slack_source(normalized, payload, dedupe_key)
  let source_refs = __slack_source_refs(normalized, source)
  let triage = __slack_triage_source(normalized, source, source_refs, dedupe_key)
  var result = base + normalized
    + {source: source, source_refs: source_refs, triage: triage, provider_raw: provider_raw}
  let summon_trigger = __agent_summon_trigger_kind(normalized?.event_type, normalized?.channel_type, normalized?.channel)
  if summon_trigger != nil {
    result = result + {agent_summon: __agent_summon(normalized, source, summon_trigger)}
  }
  return result
}

fn __slack_source(normalized, envelope, delivery_dedupe_key) {
  let event = normalized?.raw ?? {}
  let team_id = envelope?.team_id ?? event?.team ?? event?.team_id ?? event?.assistant_thread?.context?.team_id
  let enterprise_id = envelope?.enterprise_id ?? event?.enterprise_id
    ?? event?.assistant_thread?.context?.enterprise_id
  let channel = normalized?.channel ?? ""
  let message_ts = normalized?.message_ts
  let thread_ts = normalized?.thread_ts
  let source_kind = __slack_source_kind(normalized)
  let channel_url = __slack_channel_url(team_id, channel)
  let channel_deep_link = __slack_channel_deep_link(team_id, channel)
  var deep_link = channel_deep_link
  if source_kind == "app_home" && envelope?.api_app_id != nil {
    deep_link = __slack_app_home_deep_link(team_id, envelope.api_app_id, normalized?.tab)
  }
  let permalink = event?.permalink ?? event?.url ?? event?.message?.permalink
  let source_url = permalink ?? channel_url
  return {
    provider: SLACK_PROVIDER_ID,
    kind: source_kind,
    id: __slack_source_key(source_kind, team_id, channel, message_ts, normalized),
    dedupe_key: __slack_source_dedupe_key(source_kind, team_id, channel, message_ts, normalized),
    delivery_dedupe_key: delivery_dedupe_key,
    team_id: team_id,
    enterprise_id: enterprise_id,
    app_id: envelope?.api_app_id,
    channel_id: channel,
    channel_type: normalized?.channel_type,
    message_ts: message_ts,
    thread_ts: thread_ts,
    thread_root_ts: if thread_ts != nil && message_ts != nil && thread_ts != message_ts {
      thread_ts
    } else {
      nil
    },
    user_id: normalized?.user?.id,
    item_user_id: normalized?.item_user,
    event_id: envelope?.event_id,
    event_time: envelope?.event_time,
    timestamp: normalized?.occurred_at,
    url: source_url,
    deep_link: deep_link,
    permalink: permalink,
    permalink_request: __slack_permalink_request(channel, message_ts),
    raw_ref: {event_id: envelope?.event_id, event_time: envelope?.event_time},
  }
}

fn __slack_source_kind(normalized) {
  let event_type = normalized?.event_type ?? ""
  let thread_ts = normalized?.thread_ts
  let message_ts = normalized?.message_ts
  if event_type == "message" {
    if normalized?.channel_type == "im" {
      return "direct_message"
    }
    if thread_ts != nil && message_ts != nil && thread_ts != message_ts {
      return "thread_message"
    }
    return "message"
  }
  if event_type == "app_mention" {
    if thread_ts != nil && message_ts != nil && thread_ts != message_ts {
      return "thread_mention"
    }
    return "mention"
  }
  if event_type == "reaction_added" {
    if normalized?.item_type == "file" {
      return "file_reaction"
    }
    return "reaction"
  }
  if event_type == "app_home_opened" {
    return "app_home"
  }
  if event_type == "assistant_thread_started" || event_type == "assistant_thread_context_changed" {
    return "assistant_thread"
  }
  if event_type == "slash_command" {
    return "slash_command"
  }
  if event_type == "interactivity" {
    return "interactivity"
  }
  return event_type
}

fn __slack_source_refs(normalized, source) {
  var refs = [source]
  let team_id = source?.team_id
  let channel = source?.channel_id
  if channel != nil && channel != "" {
    let conversation_kind = if normalized?.channel_type == "im" || starts_with(to_string(channel), "D") {
      "direct_message"
    } else {
      "channel"
    }
    refs = refs
      .push(
      {
        provider: SLACK_PROVIDER_ID,
        kind: conversation_kind,
        id: __slack_ref_id(conversation_kind, team_id, channel),
        team_id: team_id,
        channel_id: channel,
        url: __slack_channel_url(team_id, channel),
        deep_link: __slack_channel_deep_link(team_id, channel),
      },
    )
  }
  if source?.thread_root_ts != nil {
    refs = refs
      .push(
      {
        provider: SLACK_PROVIDER_ID,
        kind: "thread",
        id: __slack_ref_id("thread", team_id, channel + ":" + to_string(source.thread_root_ts)),
        team_id: team_id,
        channel_id: channel,
        thread_ts: source.thread_root_ts,
        url: __slack_channel_url(team_id, channel),
        deep_link: __slack_channel_deep_link(team_id, channel),
        permalink_request: __slack_permalink_request(channel, source.thread_root_ts),
      },
    )
  }
  let user_id = normalized?.user?.id
  if user_id != nil && user_id != "" {
    refs = refs.push(__slack_member_ref(team_id, user_id, "actor"))
  }
  if normalized?.item_user != nil && normalized.item_user != "" && normalized.item_user != user_id {
    refs = refs.push(__slack_member_ref(team_id, normalized.item_user, "item_user"))
  }
  let item = normalized?.raw?.item ?? {}
  if item?.file != nil && item.file != "" {
    refs = refs
      .push(
      {
        provider: SLACK_PROVIDER_ID,
        kind: "file",
        id: __slack_ref_id("file", team_id, item.file),
        team_id: team_id,
        file_id: item.file,
        deep_link: __slack_file_deep_link(team_id, item.file),
      },
    )
  }
  let canvas_id = normalized?.raw?.canvas_id ?? normalized?.raw?.canvas?.id
  if canvas_id != nil && canvas_id != "" {
    refs = refs
      .push(
      {
        provider: SLACK_PROVIDER_ID,
        kind: "canvas",
        id: __slack_ref_id("canvas", team_id, canvas_id),
        team_id: team_id,
        canvas_id: canvas_id,
        url: normalized?.raw?.canvas?.url ?? normalized?.raw?.canvas_url,
      },
    )
  }
  return refs
}

fn __slack_triage_source(normalized, source, source_refs, delivery_dedupe_key) {
  let text = normalized?.text ?? ""
  let mentions = __slack_mentions(text)
  return {
    schema: "harn.triage.source.v1",
    provider: SLACK_PROVIDER_ID,
    source_kind: source?.kind,
    source_ref: source,
    source_refs: source_refs,
    source_url: source?.url,
    source_deep_link: source?.deep_link,
    source_timestamp: source?.timestamp,
    dedupe_key: source?.dedupe_key,
    delivery_dedupe_key: delivery_dedupe_key,
    actor_ids: __slack_actor_ids(normalized),
    actors: __slack_actors(normalized, source?.team_id),
    mentions: mentions,
    content_text: text,
    summary: __slack_triage_summary(normalized),
    priority_hints: {
      direct_message: source?.kind == "direct_message",
      mention: source?.kind == "mention" || source?.kind == "thread_mention",
      thread_reply: source?.kind == "thread_message" || source?.kind == "thread_mention",
      reaction: source?.kind == "reaction" || source?.kind == "file_reaction",
      user_mentions: mentions,
      unread: normalized?.raw?.unread ?? normalized?.raw?.is_unread,
      recent: true,
    },
    privacy: __slack_privacy(normalized),
    provider_raw_field: "provider_raw",
    action_intents: __slack_action_intents(normalized, source),
  }
}

fn __slack_actor_ids(normalized) {
  var actors = []
  let user_id = normalized?.user?.id
  if user_id != nil && user_id != "" {
    actors = actors.push(user_id)
  }
  let item_user = normalized?.item_user
  if item_user != nil && item_user != "" && item_user != user_id {
    actors = actors.push(item_user)
  }
  return actors
}

fn __slack_actors(normalized, team_id) {
  var actors = []
  let user = normalized?.user ?? {}
  if user?.id != nil && user.id != "" {
    actors = actors
      .push(
      {
        provider: SLACK_PROVIDER_ID,
        id: user.id,
        name: user?.name,
        role: if normalized?.event_type == "reaction_added" {
          "reactor"
        } else {
          "sender"
        },
        ref: __slack_member_ref(team_id, user.id, "actor"),
      },
    )
  }
  let item_user = normalized?.item_user
  if item_user != nil && item_user != "" && item_user != user?.id {
    actors = actors
      .push(
      {
        provider: SLACK_PROVIDER_ID,
        id: item_user,
        name: nil,
        role: "item_user",
        ref: __slack_member_ref(team_id, item_user, "item_user"),
      },
    )
  }
  return actors
}

fn __slack_privacy(normalized) {
  var flags = []
  if trim(to_string(normalized?.text ?? "")) != "" {
    flags = flags.push("contains_message_text")
  }
  if normalized?.channel_type == "im" || starts_with(to_string(normalized?.channel ?? ""), "D") {
    flags = flags.push("direct_message")
  }
  if normalized?.raw?.item?.file != nil || normalized?.raw?.file != nil {
    flags = flags.push("contains_file_ref")
  }
  return {
    classification: if contains(flags, "direct_message") {
      "private"
    } else {
      "workspace"
    },
    flags: flags,
    raw_payload_present: true,
    may_contain_user_content: contains(flags, "contains_message_text") || contains(flags, "contains_file_ref"),
  }
}

fn __slack_action_intents(normalized, source) {
  var intents = [
    {kind: "dismiss", scope: "harn", mutates_provider: false, requires_approval: false},
    {kind: "snooze", scope: "harn", mutates_provider: false, requires_approval: false},
    {
      kind: "convert_to_task",
      scope: "harn",
      mutates_provider: false,
      requires_approval: false,
      source_dedupe_key: source?.dedupe_key,
    },
  ]
  let channel = normalized?.channel
  let thread_ts = normalized?.thread_ts ?? normalized?.message_ts
  if channel != nil && channel != "" && thread_ts != nil && thread_ts != "" {
    intents = intents
      .push(
      {
        kind: "draft_reply",
        scope: "slack",
        provider_method: "chat.postMessage",
        mutates_provider: true,
        requires_approval: true,
        args_template: {channel: channel, thread_ts: thread_ts, text: nil},
      },
    )
  }
  return intents
}

fn __slack_triage_summary(normalized) {
  if normalized?.event_type == "reaction_added" {
    return "Reaction `" + to_string(normalized?.reaction ?? "") + "` on Slack "
      + to_string(normalized?.item_type ?? "item")
  }
  let text = trim(to_string(normalized?.text ?? ""))
  if text != "" {
    return text
  }
  if normalized?.event_type == "app_home_opened" {
    return "Slack App Home opened"
  }
  if normalized?.event_type == "assistant_thread_started" {
    return "Slack assistant thread started"
  }
  if normalized?.event_type == "assistant_thread_context_changed" {
    return "Slack assistant thread context changed"
  }
  if normalized?.event_type == "slash_command" {
    return "Slack slash command " + to_string(normalized?.command ?? "")
  }
  return to_string(normalized?.event_type ?? "Slack event")
}

fn __slack_mentions(text) {
  let matches = regex_match("<@[A-Za-z0-9._-]+>", to_string(text ?? ""))
  if matches == nil {
    return []
  }
  var users = []
  for token in matches {
    users = users.push(to_string(token).replace("<@", "").replace(">", ""))
  }
  return users
}

fn __eval_verdict_title(verdict) {
  let suite = to_string(verdict?.suite ?? verdict?.suite_id ?? "eval suite")
  let decision = __eval_verdict_decision(verdict)
  if decision == "regression" {
    return "Eval regression detected: " + suite
  }
  if decision == "improved" || decision == "improvement" {
    return "Eval improvement confirmed: " + suite
  }
  return "Eval verdict: " + suite
}

fn __eval_verdict_summary(verdict) {
  let paired = verdict?.paired_delta ?? verdict?.paired ?? {}
  let gate = verdict?.gate ?? {}
  return "Macro pass@1 "
    + __format_percent(
    __first_present([verdict?.macro_pass_at_1, gate?.current_macro, paired?.current_macro]),
  )
    + " vs baseline "
    + __format_percent(
    __first_present([verdict?.baseline_macro_pass_at_1, gate?.baseline_macro, paired?.baseline_macro]),
  )
    + "; paired delta "
    + __format_delta(__first_present([paired?.mean_delta, verdict?.paired_delta_mean]))
    + " (95% CI "
    + __format_delta(__first_present([paired?.ci_lo, verdict?.paired_delta_ci_lo]))
    + " to "
    + __format_delta(__first_present([paired?.ci_hi, verdict?.paired_delta_ci_hi]))
    + "); gate "
    + __eval_verdict_decision(verdict)
    + "."
}

fn __eval_verdict_fields(verdict) {
  let gate = verdict?.gate ?? {}
  let paired = verdict?.paired_delta ?? verdict?.paired ?? {}
  let reliability = verdict?.reliability ?? {}
  return [
    {type: "mrkdwn", text: "*Model*\n" + to_string(verdict?.model ?? "unknown")},
    {type: "mrkdwn", text: "*Split*\n" + to_string(verdict?.split ?? "default")},
    {
      type: "mrkdwn",
      text: "*Macro pass@1*\n"
        + __format_percent(
        __first_present([verdict?.macro_pass_at_1, gate?.current_macro, paired?.current_macro]),
      ),
    },
    {
      type: "mrkdwn",
      text: "*Gate threshold*\n"
        + __format_percent(__first_present([gate?.threshold, paired?.regression_threshold])),
    },
    {
      type: "mrkdwn",
      text: "*Paired delta*\n"
        + __format_delta(__first_present([paired?.mean_delta, verdict?.paired_delta_mean]))
        + " ["
        + __format_delta(__first_present([paired?.ci_lo, verdict?.paired_delta_ci_lo]))
        + ", "
        + __format_delta(__first_present([paired?.ci_hi, verdict?.paired_delta_ci_hi]))
        + "]",
    },
    {
      type: "mrkdwn",
      text: "*Reliability*\nall-pass " + __format_percent(reliability?.all_pass)
        + ", flaky "
        + __format_percent(reliability?.flaky)
        + ", all-fail "
        + __format_percent(reliability?.all_fail),
    },
  ]
}

fn __eval_verdict_decision(verdict) {
  let explicit = verdict?.decision ?? verdict?.status
  if explicit != nil && trim(to_string(explicit)) != "" {
    return lowercase(to_string(explicit))
  }
  let gate = verdict?.gate ?? {}
  if gate?.status != nil && trim(to_string(gate.status)) != "" {
    return lowercase(to_string(gate.status))
  }
  let paired = verdict?.paired_delta ?? verdict?.paired ?? {}
  if paired?.status != nil && trim(to_string(paired.status)) != "" {
    return lowercase(to_string(paired.status))
  }
  if !(gate?.passed ?? true) || paired?.regression ?? false {
    return "regression"
  }
  if paired?.improved ?? false {
    return "improved"
  }
  return "inconclusive"
}

fn __eval_verdict_case_lines(cases, limit) {
  var lines = ""
  var count = 0
  for case in cases ?? [] {
    if count < limit {
      let label = to_string(case?.name ?? case?.case ?? case?.id ?? "case")
      let fingerprint = to_string(case?.fingerprint ?? case?.case_fingerprint ?? case?.current_fingerprint ?? "unknown")
      let delta = __format_delta(case?.delta ?? case?.pass_delta ?? case?.paired_delta)
      lines = lines + "- `" + label + "` " + delta + " (`" + fingerprint + "`)\n"
      count = count + 1
    }
  }
  return trim(lines)
}

fn __first_present(values) {
  for value in values ?? [] {
    if value != nil {
      return value
    }
  }
  return nil
}

fn __format_percent(value) {
  if value == nil {
    return "n/a"
  }
  return to_string(round(value * 1000.0) / 10.0) + "%"
}

fn __format_delta(value) {
  if value == nil {
    return "n/a"
  }
  let pct = round(value * 10000.0) / 100.0
  if pct > 0.0 {
    return "+" + to_string(pct) + " pp"
  }
  return to_string(pct) + " pp"
}

fn __slack_source_key(source_kind, team_id, channel, message_ts, normalized) {
  if channel != nil && channel != "" && message_ts != nil && message_ts != "" {
    return __slack_ref_id(source_kind, team_id, channel + ":" + to_string(message_ts))
  }
  if normalized?.user?.id != nil && normalized.user.id != "" {
    return __slack_ref_id(source_kind, team_id, normalized.user.id)
  }
  return __slack_ref_id(source_kind, team_id, normalized?.resource_id ?? normalized?.event_type ?? "unknown")
}

fn __slack_source_dedupe_key(source_kind, team_id, channel, message_ts, normalized) {
  let team = __slack_team_part(team_id)
  if source_kind == "reaction" || source_kind == "file_reaction" {
    return "slack:reaction:" + team + ":" + to_string(channel ?? "") + ":" + to_string(message_ts ?? "")
      + ":"
      + to_string(normalized?.reaction ?? "")
      + ":"
      + to_string(normalized?.user?.id ?? "")
  }
  if channel != nil && channel != "" && message_ts != nil && message_ts != "" {
    return "slack:message:" + team + ":" + to_string(channel) + ":" + to_string(message_ts)
  }
  return "slack:" + to_string(source_kind) + ":" + team + ":"
    + to_string(normalized?.resource_id ?? "unknown")
}

fn __slack_ref_id(kind, team_id, id) {
  return "slack:" + to_string(kind) + ":" + __slack_team_part(team_id) + ":" + to_string(id ?? "unknown")
}

fn __slack_team_part(team_id) {
  if team_id == nil || trim(to_string(team_id)) == "" {
    return "unknown-team"
  }
  return to_string(team_id)
}

fn __slack_member_ref(team_id, user_id, role) {
  return {
    provider: SLACK_PROVIDER_ID,
    kind: "member",
    role: role,
    id: __slack_ref_id("member", team_id, user_id),
    team_id: team_id,
    user_id: user_id,
    deep_link: __slack_member_deep_link(team_id, user_id),
  }
}

fn __slack_channel_url(team_id, channel) {
  if channel == nil || trim(to_string(channel)) == "" {
    return nil
  }
  var query = [{key: "channel", value: to_string(channel)}]
  if team_id != nil && trim(to_string(team_id)) != "" {
    query = query.push({key: "team", value: to_string(team_id)})
  }
  return "https://slack.com/app_redirect?" + query_stringify(query)
}

fn __slack_channel_deep_link(team_id, channel) {
  if channel == nil || trim(to_string(channel)) == "" || team_id == nil
    || trim(to_string(team_id)) == "" {
    return nil
  }
  return "slack://channel?"
    + query_stringify([{key: "team", value: to_string(team_id)}, {key: "id", value: to_string(channel)}])
}

fn __slack_member_deep_link(team_id, user_id) {
  if user_id == nil || trim(to_string(user_id)) == "" || team_id == nil
    || trim(to_string(team_id)) == "" {
    return nil
  }
  return "slack://user?"
    + query_stringify([{key: "team", value: to_string(team_id)}, {key: "id", value: to_string(user_id)}])
}

fn __slack_file_deep_link(team_id, file_id) {
  if file_id == nil || trim(to_string(file_id)) == "" || team_id == nil
    || trim(to_string(team_id)) == "" {
    return nil
  }
  return "slack://file?"
    + query_stringify([{key: "team", value: to_string(team_id)}, {key: "id", value: to_string(file_id)}])
}

fn __slack_app_home_deep_link(team_id, app_id, tab = nil) {
  if app_id == nil || trim(to_string(app_id)) == "" || team_id == nil || trim(to_string(team_id)) == "" {
    return nil
  }
  var query = [{key: "team", value: to_string(team_id)}, {key: "id", value: to_string(app_id)}]
  if tab != nil && trim(to_string(tab)) != "" {
    query = query.push({key: "tab", value: to_string(tab)})
  }
  return "slack://app?" + query_stringify(query)
}

fn __slack_permalink_request(channel, message_ts) {
  if channel == nil || trim(to_string(channel)) == "" || message_ts == nil
    || trim(to_string(message_ts)) == "" {
    return nil
  }
  return {
    method: "chat.getPermalink",
    args: {channel: channel, message_ts: message_ts},
    mutates_provider: false,
    requires_approval: false,
  }
}

fn __outbound_config(args) {
  let api_base_url_check = __validate_api_base_url(args?.api_base_url)
  if is_err(api_base_url_check) {
    return api_base_url_check
  }
  let api_base_url = unwrap(api_base_url_check)
  let bot_token = __first_secret_value([args?.bot_token, args?.token, args?.secrets?.bot_token], nil)
    ?? __secret_get_optional(__first_secret_id([args?.bot_token_secret, args?.secrets?.bot_token_secret]))
    ?? __secret_get_optional("slack/bot-token")
  if bot_token == nil || trim(to_string(bot_token)) == "" {
    return __err("missing_bot_token", "slack connector requires bot_token")
  }
  return Ok({api_base_url: to_string(api_base_url), bot_token: to_string(bot_token)})
}

/**
 * Enforce the secure-default Socket Mode gate. Socket Mode connects only when
 * (1) it is explicitly enabled via args, binding, or connector ctx, AND (2) an
 * app-level `xapp-` token is resolvable. Returns Ok(true) when allowed, or an
 * __err describing why the connector stays on the HTTP Events path.
 */
fn __socket_mode_enabled(args) {
  if !__socket_mode_enable_flag(args) {
    return __err(
      "socket_mode_disabled",
      "Slack Socket Mode is off by default; enable it (args.enable_socket_mode, binding, or ctx socket_mode.enabled) and grant the streaming capability before connecting",
    )
  }
  let token_result = __socket_mode_config(args)
  if is_err(token_result) {
    return token_result
  }
  let app_token = unwrap(token_result)?.app_token
  if app_token == nil || !starts_with(to_string(app_token), "xapp-") {
    return __err(
      "missing_app_token",
      "Slack Socket Mode requires an app-level `xapp-` token; configure slack/app-token",
    )
  }
  return Ok(true)
}

/**
 * Read the Socket Mode enable flag from the most-trusted source available:
 * explicit args first, then the matched binding, then connector ctx.
 */
fn __socket_mode_enable_flag(args) {
  let from_args = args?.enable_socket_mode ?? args?.socket_mode?.enabled ?? args?.enable
  if from_args != nil {
    return __is_true(from_args)
  }
  let state = __state()
  let bindings = state.bindings ?? {}
  let binding_id = args?.binding_id ?? args?.metadata?.binding_id
  if binding_id != nil {
    let binding = bindings.get(binding_id)
    let from_binding = binding?.enable_socket_mode ?? binding?.socket_mode?.enabled
      ?? binding?.config?.enable_socket_mode
      ?? binding?.config?.socket_mode?.enabled
    if from_binding != nil {
      return __is_true(from_binding)
    }
  }
  let from_ctx = state.ctx?.enable_socket_mode ?? state.ctx?.socket_mode?.enabled
  return __is_true(from_ctx)
}

/** Strict boolean-true check: only the literal `true` enables a guarded path. */
fn __is_true(value) {
  match value {
    true -> { return true }
    _ -> { return false }
  }
}

fn __socket_mode_config(args) {
  let api_base_url_check = __validate_api_base_url(args?.api_base_url)
  if is_err(api_base_url_check) {
    return api_base_url_check
  }
  let api_base_url = unwrap(api_base_url_check)
  let app_token = __first_secret_value([args?.app_token, args?.token, args?.secrets?.app_token], nil)
    ?? __secret_get_optional(__first_secret_id([args?.app_token_secret, args?.secrets?.app_token_secret]))
    ?? __secret_get_optional("slack/app-token")
  if app_token == nil || trim(to_string(app_token)) == "" {
    return __err("missing_app_token", "Slack Socket Mode requires app_token")
  }
  return Ok({api_base_url: to_string(api_base_url), app_token: to_string(app_token)})
}

fn __socket_handle(connection) {
  return connection?.socket ?? connection?.id ?? connection
}

fn __socket_mode_ack(socket, envelope) {
  let envelope_id = envelope?.envelope_id
  if envelope_id == nil || trim(to_string(envelope_id)) == "" {
    return {acked: false, envelope_id: nil}
  }
  return socket_mode_ack(socket, envelope_id)
}

fn __slack_api_url(api_base_url, method) {
  let trimmed = trim(to_string(api_base_url))
  if trimmed.ends_with("/") {
    return trimmed[0:len(trimmed) - 1] + "/" + method
  }
  return trimmed + "/" + method
}

/**
 * Extract the host from a URL string (case-insensitive). Returns nil for
 * inputs that don't look like an absolute http(s) URL.
 */
fn __extract_host(url) {
  let trimmed = trim(to_string(url ?? ""))
  if trimmed == "" {
    return nil
  }
  let lower = lowercase(trimmed)
  var rest = nil
  if lower.starts_with("https://") {
    rest = trimmed[8:len(trimmed)]
  } else if lower.starts_with("http://") {
    rest = trimmed[7:len(trimmed)]
  } else {
    return nil
  }
  // Strip optional userinfo and trailing path/query/fragment to isolate host.
  let at_idx = rest.index_of("@")
  if at_idx != nil && at_idx >= 0 {
    rest = rest[at_idx + 1:len(rest)]
  }
  var end = len(rest)
  for ch in ["/", "?", "#"] {
    let idx = rest.index_of(ch)
    if idx != nil && idx >= 0 && idx < end {
      end = idx
    }
  }
  var host = rest[0:end]
  // Strip optional port (host:port).
  let colon_idx = host.index_of(":")
  if colon_idx != nil && colon_idx >= 0 {
    host = host[0:colon_idx]
  }
  return lowercase(host)
}

/**
 * Validate caller-supplied `api_base_url` against the connector allowlist.
 * Returns Ok(trimmed_url) when accepted, or __err otherwise.
 */
fn __validate_api_base_url(api_base_url) {
  if api_base_url == nil {
    return Ok(SLACK_API_BASE_URL)
  }
  let text = trim(to_string(api_base_url))
  if text == "" || text == SLACK_API_BASE_URL {
    return Ok(SLACK_API_BASE_URL)
  }
  let host = __extract_host(text)
  if host == nil {
    return __err("invalid_api_base_url", "slack api_base_url must be an absolute http(s) URL")
  }
  if !contains(SLACK_ALLOWED_API_HOSTS, host) {
    return __err("disallowed_api_base_url", "slack api_base_url host `" + host + "` is not in the allowlist")
  }
  return Ok(text)
}
