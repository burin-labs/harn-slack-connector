const SLACK_PROVIDER_ID = "slack"

const SLACK_API_BASE_URL = "https://slack.com/api"

/**
 * Hosts permitted for outbound Slack Web API calls. Caller-supplied
 * `api_base_url` overrides are validated against this allowlist to prevent
 * bot/app tokens from being shipped to attacker-controlled hosts.
 */
const SLACK_ALLOWED_API_HOSTS = ["slack.com", "api.slack.com"]

const SLACK_FILE_DOWNLOAD_SECRET = "slack/bot-token"

const SLACK_SIGNATURE_WINDOW_SECONDS = 300

const SLACK_REDACTED_HEADER_VALUE = "[redacted]"

const SLACK_CUSTOMIZE_SCOPE = "chat:write.customize"

